{
  "name": "@pratikpsl/agent-skills",
  "type": "module",
  "version": "0.9.0",
  "description": "CLI to scaffold and manage AI agent skills across projects — like shadcn/ui, but for Cursor, Claude, Codex, Copilot, Antigravity, and more",
  "bin": {
    "agent-skills": "dist/bin/agent-skills.js"
  },
  "packageManager": "bun@1.4.0",
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai",
    "agent-skills",
    "cursor",
    "claude",
    "cli",
    "scaffold",
    "copilot",
    "codex",
    "dotnet",
    "agents",
    "antigravity",
    "typescript"
  ],
  "homepage": "https://github.com/pratiksinghlad/coding-skills-ai#readme",
  "bugs": {
    "url": "https://github.com/pratiksinghlad/coding-skills-ai/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pratiksinghlad/coding-skills-ai.git"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "dry-run": "bun run build && npm publish --dry-run"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
